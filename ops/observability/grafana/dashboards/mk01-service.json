{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Deployments and incidents",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": true,
      "title": "Operations runbook",
      "type": "link",
      "url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Rolling non-5xx ratio for product APIs. Probes, metrics and anonymous telemetry are excluded at emission.",
      "fieldConfig": { "defaults": { "decimals": 3, "max": 1, "min": 0, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(mk01_http_responses_total{class!=\"5xx\"}[5m])) / clamp_min(sum(rate(mk01_http_responses_total[5m])), 1)",
          "legendFormat": "availability",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Product API availability",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Accepted product command p95 and p99 across HTTP and WebSocket transports.",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, transport) (rate(mk01_command_duration_milliseconds_bucket{outcome=\"accepted\"}[5m])))",
          "legendFormat": "{{transport}} p95",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, transport) (rate(mk01_command_duration_milliseconds_bucket{outcome=\"accepted\"}[5m])))",
          "legendFormat": "{{transport}} p99",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Accepted command latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Queue-to-durable-room p95, current queue depth, and oldest queue age.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mk01_matchmaking_duration_seconds_bucket[15m])))",
          "legendFormat": "wait p95",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(mk01_matchmaking_queue_depth)",
          "legendFormat": "queue depth",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "max(mk01_matchmaking_oldest_age_seconds)",
          "legendFormat": "oldest entry",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Matchmaking latency and queue",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Abnormal closes as a share of completed sockets, guarded by session volume.",
      "fieldConfig": { "defaults": { "decimals": 3, "min": 0, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(mk01_unexpected_disconnects_total[30m])) / clamp_min(sum(increase(mk01_websocket_disconnects_total[30m])), 1)",
          "legendFormat": "unexpected rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Unexpected disconnects",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Persisted disconnect to successful authoritative reconnect save.",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mk01_active_match_recovery_milliseconds_bucket[15m])))",
          "legendFormat": "recovery p95",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(increase(mk01_active_match_recovery_milliseconds_count[15m]))",
          "legendFormat": "recovery samples",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Active-match recovery",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Cross-instance delivery failures, fencing conflicts and persisted mutations.",
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(mk01_distributed_event_failures_total[5m]))", "legendFormat": "event failures/s", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(mk01_room_authority_conflicts_total[5m]))", "legendFormat": "authority conflicts/s", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "sum(rate(mk01_room_version_conflicts_total[5m]))", "legendFormat": "version conflicts/s", "range": true, "refId": "C" },
        { "editorMode": "code", "expr": "sum(rate(mk01_room_mutations_total[5m]))", "legendFormat": "mutations/s", "range": true, "refId": "D" }
      ],
      "title": "Distributed correctness",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Privacy-bounded p75 Web Vitals by route and supported device tier.",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.75, sum by (le, route, device_tier) (rate(mk01_rum_lcp_milliseconds_bucket[1h])))", "legendFormat": "LCP {{route}} {{device_tier}}", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.75, sum by (le, route, device_tier) (rate(mk01_rum_inp_milliseconds_bucket[1h])))", "legendFormat": "INP {{route}} {{device_tier}}", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "histogram_quantile(0.75, sum by (le, route, device_tier) (rate(mk01_rum_cls_milli_bucket[1h])))", "legendFormat": "CLS milli {{route}} {{device_tier}}", "range": true, "refId": "C" }
      ],
      "title": "Core Web Vitals",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Player attack input to matching authoritative result by device tier.",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, device_tier) (rate(mk01_rum_battle_interaction_milliseconds_bucket[1h])))", "legendFormat": "{{device_tier}} p95", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum by (device_tier) (increase(mk01_rum_battle_interaction_milliseconds_count[1h]))", "legendFormat": "{{device_tier}} samples", "range": true, "refId": "B" }
      ],
      "title": "Battle interaction",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Reached, abandoned and failed onboarding stages with fixed labels.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (stage, outcome) (increase(mk01_new_player_funnel_events_total[24h]))", "legendFormat": "{{stage}} {{outcome}}", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum by (reason) (increase(mk01_new_player_funnel_failures_total[24h]))", "legendFormat": "failure {{reason}}", "range": true, "refId": "B" }
      ],
      "title": "New-player funnel",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Retention deletions and provider-exported encrypted backup age.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(mk01_retention_sessions_deleted_total[1h]))", "legendFormat": "sessions deleted/s", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(mk01_retention_rooms_deleted_total[1h]))", "legendFormat": "rooms deleted/s", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "max(mk01_backup_age_seconds)", "legendFormat": "backup age seconds", "range": true, "refId": "C" }
      ],
      "title": "Retention and backup",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Share of completed ranked pairs that required recent-opponent relaxation after mutual global wait.",
      "fieldConfig": { "defaults": { "decimals": 3, "min": 0, "max": 1, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(mk01_ranked_matchmaking_rematches_total[30m])) / clamp_min(sum(increase(mk01_ranked_matchmaking_completed_total[30m])), 1)",
          "legendFormat": "relaxed rematch share",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Ranked rematch quality",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mk01", "production", "slo"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Prometheus",
        "name": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Mk.01 Service and Player Experience",
  "uid": "mk01-service-slo",
  "version": 1,
  "weekStart": "monday"
}
