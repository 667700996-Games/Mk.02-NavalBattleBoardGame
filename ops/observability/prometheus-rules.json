{
  "groups": [
    {
      "name": "mk01-slo",
      "interval": "30s",
      "rules": [
        {
          "alert": "Mk01AvailabilityFastBurn",
          "expr": "((sum(rate(mk01_http_responses_total{class=\"5xx\"}[1h])) / clamp_min(sum(rate(mk01_http_responses_total[1h])), 1)) / 0.0005 > 14.4) and ((sum(rate(mk01_http_responses_total{class=\"5xx\"}[5m])) / clamp_min(sum(rate(mk01_http_responses_total[5m])), 1)) / 0.0005 > 14.4)",
          "for": "2m",
          "labels": {
            "severity": "page",
            "service": "mk01",
            "slo": "availability"
          },
          "annotations": {
            "summary": "Mk.01 is rapidly consuming its availability error budget",
            "description": "The one-hour and five-minute windows both exceed the 14.4x burn threshold.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#core-service-slo-signals"
          }
        },
        {
          "alert": "Mk01AvailabilitySlowBurn",
          "expr": "((sum(rate(mk01_http_responses_total{class=\"5xx\"}[6h])) / clamp_min(sum(rate(mk01_http_responses_total[6h])), 1)) / 0.0005 > 6) and ((sum(rate(mk01_http_responses_total{class=\"5xx\"}[30m])) / clamp_min(sum(rate(mk01_http_responses_total[30m])), 1)) / 0.0005 > 6)",
          "for": "15m",
          "labels": {
            "severity": "page",
            "service": "mk01",
            "slo": "availability"
          },
          "annotations": {
            "summary": "Mk.01 is steadily consuming its availability error budget",
            "description": "The six-hour and thirty-minute windows both exceed the 6x burn threshold.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#core-service-slo-signals"
          }
        },
        {
          "alert": "Mk01InstanceNotReady",
          "expr": "up{job=\"mk01\"} == 0",
          "for": "2m",
          "labels": {
            "severity": "page",
            "service": "mk01",
            "slo": "availability"
          },
          "annotations": {
            "summary": "A Mk.01 instance is not scrapeable or ready",
            "description": "Prometheus has observed the instance as down for two minutes.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#dependency-failure-drills"
          }
        },
        {
          "alert": "Mk01CommandLatency",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mk01_command_duration_milliseconds_bucket{outcome=\"accepted\"}[5m]))) > 150",
          "for": "15m",
          "labels": {
            "severity": "page",
            "service": "mk01",
            "slo": "command-latency"
          },
          "annotations": {
            "summary": "Accepted command p95 is above 150 ms",
            "description": "HTTP and WebSocket command processing exceeds the production SLO.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#core-service-slo-signals"
          }
        },
        {
          "alert": "Mk01MatchmakingLatency",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mk01_matchmaking_duration_seconds_bucket[15m]))) > 30",
          "for": "10m",
          "labels": {
            "severity": "page",
            "service": "mk01",
            "slo": "matchmaking-latency"
          },
          "annotations": {
            "summary": "Matchmaking p95 is above 30 seconds",
            "description": "Queue-to-durable-room latency exceeds the healthy-pool objective.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#core-service-slo-signals"
          }
        },
        {
          "alert": "Mk01RankedRematchRate",
          "expr": "(sum(increase(mk01_ranked_matchmaking_rematches_total[30m])) / clamp_min(sum(increase(mk01_ranked_matchmaking_completed_total[30m])), 1) > 0.25) and (sum(increase(mk01_ranked_matchmaking_completed_total[30m])) >= 20)",
          "for": "30m",
          "labels": {
            "severity": "ticket",
            "service": "mk01",
            "slo": "matchmaking-fairness"
          },
          "annotations": {
            "summary": "Ranked recent-opponent relaxation exceeds 25 percent",
            "description": "At least 20 ranked pairs completed and more than one quarter required a recent opponent, indicating insufficient healthy pool diversity.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#core-service-slo-signals"
          }
        },
        {
          "alert": "Mk01UnexpectedDisconnectRate",
          "expr": "(sum(increase(mk01_unexpected_disconnects_total[30m])) / clamp_min(sum(increase(mk01_websocket_disconnects_total[30m])), 1) > 0.005) and (sum(increase(mk01_websocket_disconnects_total[30m])) >= 100)",
          "for": "5m",
          "labels": {
            "severity": "page",
            "service": "mk01",
            "slo": "disconnect-rate"
          },
          "annotations": {
            "summary": "Unexpected disconnect rate exceeds 0.5 percent",
            "description": "At least 100 sockets completed and abnormal closes exceeded the production objective.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#dependency-failure-drills"
          }
        },
        {
          "alert": "Mk01ActiveMatchRecovery",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(mk01_active_match_recovery_milliseconds_bucket[15m]))) > 10000) and (sum(increase(mk01_active_match_recovery_milliseconds_count[15m])) > 0)",
          "for": "5m",
          "labels": {
            "severity": "page",
            "service": "mk01",
            "slo": "active-match-recovery"
          },
          "annotations": {
            "summary": "Active-match recovery p95 exceeds 10 seconds",
            "description": "Persisted disconnect-to-authoritative-save recovery is outside the SLO.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#dependency-failure-drills"
          }
        },
        {
          "alert": "Mk01DistributedEventFailure",
          "expr": "sum(rate(mk01_distributed_event_failures_total[5m])) > 0",
          "for": "2m",
          "labels": {
            "severity": "page",
            "service": "mk01",
            "slo": "distributed-correctness"
          },
          "annotations": {
            "summary": "Cross-instance event delivery is failing",
            "description": "Redis-backed event publication has failed during the last five minutes.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#dependency-failure-drills"
          }
        },
        {
          "alert": "Mk01RoomMutationStalled",
          "expr": "(sum(rate(mk01_command_duration_milliseconds_count{transport=\"websocket\",outcome=\"accepted\"}[5m])) > 0) and (sum(rate(mk01_room_mutations_total[5m])) == 0)",
          "for": "5m",
          "labels": {
            "severity": "page",
            "service": "mk01",
            "slo": "distributed-correctness"
          },
          "annotations": {
            "summary": "Commands are accepted but no room mutation is being persisted",
            "description": "The authoritative persistence path may be stalled or fenced incorrectly.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#dependency-failure-drills"
          }
        },
        {
          "alert": "Mk01WebVitalRegression",
          "expr": "(histogram_quantile(0.75, sum by (le, route, device_tier) (rate(mk01_rum_lcp_milliseconds_bucket[15m]))) > 4000) and (sum by (route, device_tier) (increase(mk01_rum_lcp_milliseconds_count[15m])) >= 100)",
          "for": "15m",
          "labels": {
            "severity": "ticket",
            "service": "mk01",
            "slo": "player-performance"
          },
          "annotations": {
            "summary": "A route and device tier has poor LCP",
            "description": "LCP p75 exceeded four seconds with at least 100 bounded RUM samples.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#real-user-performance"
          }
        },
        {
          "alert": "Mk01BackupTooOld",
          "expr": "mk01_backup_age_seconds > 43200",
          "for": "15m",
          "labels": {
            "severity": "page",
            "service": "mk01",
            "slo": "recovery"
          },
          "annotations": {
            "summary": "The latest encrypted backup is older than the 12-hour RPO",
            "description": "The provider backup exporter reports an RPO violation.",
            "runbook_url": "https://github.com/orca-crew/Mk.01-GameProject-NavalBattleBoardGame/blob/main/docs/OPERATIONS.md#backup-and-restore-drill"
          }
        }
      ]
    }
  ]
}
