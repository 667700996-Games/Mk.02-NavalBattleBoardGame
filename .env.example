# Application
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_COOKIES=false
SESSION_TTL_SECONDS=2592000
RECONNECT_GRACE_SECONDS=90
# 0 disables the turn limit. Production default is 60 seconds.
TURN_DURATION_SECONDS=60
API_REQUESTS_PER_MINUTE=240
HTTP_REQUESTS_PER_MINUTE_PER_IP=600
SESSION_CREATIONS_PER_MINUTE=20
WEBSOCKET_EVENTS_PER_SECOND=60
WEBSOCKET_SEND_QUEUE_CAPACITY=256
MAX_WEBSOCKET_CONNECTIONS=10000
# Enable only when the server is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
# Require Redis fan-out for multi-instance production. Startup/readiness fail if unavailable.
DISTRIBUTED_COORDINATION_REQUIRED=false
RUST_LOG=mk01_server=info,tower_http=info

# Use "memory" for a dependency-free local game or "postgres" for durable operation.
STORAGE_MODE=memory
DATABASE_URL=postgres://mk01:change-me@localhost:5432/mk01
REDIS_URL=redis://localhost:6379/
