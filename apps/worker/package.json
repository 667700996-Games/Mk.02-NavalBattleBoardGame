{
  "name": "@mk01/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../web/wrangler.jsonc",
    "build": "wrangler deploy --dry-run --config ../web/wrangler.jsonc --outdir dist",
    "deploy": "wrangler deploy --config ../web/wrangler.jsonc",
    "types": "wrangler types --include-runtime false --config ../web/wrangler.jsonc ../web/worker-configuration.d.ts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260819.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.124.0"
  }
}
