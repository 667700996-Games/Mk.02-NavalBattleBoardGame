{
  "name": "@mk01/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "MK01_WEB_ADAPTER=node vite --host 0.0.0.0",
    "build": "vite build",
    "build:cloudflare": "vite build",
    "build:node": "MK01_WEB_ADAPTER=node vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test e2e/accessibility.spec.ts e2e/color-vision.spec.ts e2e/input-prompts.spec.ts --project=chromium",
    "test:localization": "playwright test e2e/localization.spec.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:cloudflare": "playwright test --config playwright.cloudflare.config.ts",
    "test:performance": "npm run build && playwright test --config=playwright.performance.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@lucide/svelte": "1.35.0",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
